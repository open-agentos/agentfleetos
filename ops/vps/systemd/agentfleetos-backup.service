# ops/vps/systemd/agentfleetos-backup.service: one consistent copy of swarm.db (#659),
# run by agentfleetos-backup.timer. Keeps the newest 14 in $PRODUCTSWARM_HOME/launcher/backups.
[Unit]
Description=AgentFleetOS swarm.db backup (swarm backup)

[Service]
Type=oneshot
User=swarm
Group=swarm
Environment=PRODUCTSWARM_HOME=/home/swarm/.agentfleetos
WorkingDirectory=/home/swarm/agentfleetos
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/swarm/agentfleetos/launcher/swarm backup
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/home/swarm/.agentfleetos
