# ops/vps/systemd/agentfleetos-watch.service: the always-on watcher (#660).
# It checks on each webhook nudge (at most every 30 s) and every interval_minutes as a sweep.
# --dry-run until #661: starting role sessions on this host needs the containers from #661,
# since the launcher's runtime opens macOS Terminal windows. Drop --dry-run once that merges.
[Unit]
Description=AgentFleetOS watcher (swarm watch --serve)
After=network-online.target agentfleetos-webhooks.service
Wants=network-online.target

[Service]
User=swarm
Group=swarm
Environment=PRODUCTSWARM_HOME=/home/swarm/.agentfleetos
WorkingDirectory=/home/swarm/agentfleetos
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/agentfleetos/secrets.env
ExecStart=/home/swarm/agentfleetos/launcher/swarm watch --serve --dry-run
Restart=always
RestartSec=10s
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
