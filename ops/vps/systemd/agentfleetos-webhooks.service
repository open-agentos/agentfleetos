# ops/vps/systemd/agentfleetos-webhooks.service: the GitHub webhook receiver (#658).
# It checks each delivery's signature, records it in swarm.db and touches the nudge file.
[Unit]
Description=AgentFleetOS webhook receiver (swarm webhooks)
After=network-online.target
Wants=network-online.target

[Service]
User=swarm
Group=swarm
Environment=PRODUCTSWARM_HOME=/home/swarm/.agentfleetos
WorkingDirectory=/home/swarm/agentfleetos
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/agentfleetos/webhooks.env
ExecStart=/home/swarm/agentfleetos/launcher/swarm webhooks --host 127.0.0.1 --port 8081
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/home/swarm/.agentfleetos

[Install]
WantedBy=multi-user.target
